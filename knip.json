{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.js"]
    },
    "packages/build": {
      "project": ["src/**/*.js"],
      "ignoreDependencies": ["@lvce-editor/verror", "esbuild"]
    },
    "packages/file-permission-process": {
      "entry": ["src/filePermissionProcessMain.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
